{
  "name": "ai-103-practice-exam",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/vinext-run.mjs dev",
    "dev:pages": "vite --config vite.pages.config.ts",
    "build": "node scripts/vinext-run.mjs build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "node scripts/vinext-run.mjs start",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "test": "npm run build && npm run build:pages && node --import tsx --test tests/rendered-html.test.mjs tests/pages-output.test.mjs tests/question-bank.test.ts tests/option-shuffle.test.ts tests/question-selection.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
